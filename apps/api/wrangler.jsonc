{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-22",
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ai-agent-local-auth",
			"database_id": "91e63d07-bee3-4c00-9349-cfde384ba6eb",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "AVATAR_BUCKET",
			"bucket_name": "ai-agent-local-avatars"
		}
	],
	"vars": {
		"APP_ENV": "development",
		"ADMIN_ORIGIN": "http://localhost:3006",
		"WEB_ORIGIN": "http://localhost:3005",
		"ACCESS_TOKEN_TTL_SEC": "900",
		"REFRESH_TOKEN_TTL_SEC": "2592000",
		"DEEPSEEK_BASE_URL": "https://api.deepseek.com/v1",
		"DEEPSEEK_MODEL": "deepseek-chat",
		"GITHUB_OAUTH_CALLBACK_URL": "http://127.0.0.1:8787/auth/web/github/callback"
	},
	"env": {
		"test": {
			"triggers": {
				"crons": ["*/5 * * * *"]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ai-agent-test-auth",
					"database_id": "22222222-2222-4222-8222-222222222222",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "AVATAR_BUCKET",
					"bucket_name": "ai-agent-test-avatars"
				}
			],
			"vars": {
				"APP_ENV": "test",
				"ADMIN_ORIGIN": "http://localhost:3006",
				"WEB_ORIGIN": "http://localhost:3005",
				"ACCESS_TOKEN_TTL_SEC": "900",
				"REFRESH_TOKEN_TTL_SEC": "2592000",
				"DEEPSEEK_BASE_URL": "https://api.deepseek.com/v1",
				"DEEPSEEK_MODEL": "deepseek-chat"
			}
		},
		"production": {
			"name": "ai-spirit-api-production",
			"workers_dev": true,
			"triggers": {
				"crons": ["*/5 * * * *"]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ai-spirit-agent-db-production",
					"database_id": "02237b47-d9c4-486e-b11f-bb236ff6c859",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "AVATAR_BUCKET",
					"bucket_name": "ai-spirit-avatars-production"
				}
			],
			"vars": {
				"APP_ENV": "production",
				"ADMIN_ORIGIN": "https://ai-spirit-admin.pages.dev",
				"WEB_ORIGIN": "https://ai-spirit-web.pages.dev",
				"ACCESS_TOKEN_TTL_SEC": "900",
				"REFRESH_TOKEN_TTL_SEC": "2592000",
				"DEEPSEEK_BASE_URL": "https://api.deepseek.com/v1",
				"DEEPSEEK_MODEL": "deepseek-chat",
				"GITHUB_OAUTH_CLIENT_ID": "Ov23liC4rrbfsMq9vwC3",
				"GITHUB_OAUTH_CALLBACK_URL": "https://ai-spirit-api-production.lavacourage07.workers.dev/auth/web/github/callback"
			}
		}
	}
}
